{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @linux-learn/mobile export:web",
  "outputDirectory": "apps/mobile/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/site",
      "destination": "/site/index.html"
    },
    {
      "source": "/site/",
      "destination": "/site/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/site/privacy.html"
    },
    {
      "source": "/support",
      "destination": "/site/support.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
